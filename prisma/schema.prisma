generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id          String        @id @db.Uuid
  name        String
  budget      Float         @default(0)
  Soggetto    Soggetto[]
  Transazione Transazione[]
}

model Soggetto {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sesso       Boolean?
  dataNascita DateTime @db.Date
  gabbia      Int?
  numero      String
  rna         String
  preferito   Boolean  @default(false)
  profileId   String   @db.Uuid
  avatar      String?
  profile     Profile  @relation(fields: [profileId], references: [id])
}

model Nazione {
  id    Int    @id @default(autoincrement())
  nome  String
  sigla String
  gare  Gara[]
}

model Gara {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  titolo     String
  dataEvento DateTime @db.Date
  tipologia  String
  citta      String
  immagine   String?
  nazioneId  Int
  createdAt  DateTime @default(now())
  isDeleted  Boolean  @default(false)
  prezzo     Float    @default(0)
  capienza   Int
  nazione    Nazione  @relation(fields: [nazioneId], references: [id])
}

model Transazione {
  id           Int             @id @default(autoincrement())
  created_at   DateTime        @default(now()) @db.Timestamptz(6)
  categoriaId  Int
  data         DateTime        @db.Date
  prezzo       Float
  descrizione  String?         @db.VarChar
  modificabile Boolean         @default(true)
  user_id      String          @db.Uuid
  categoria    categorie_spese @relation(fields: [categoriaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user         Profile         @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model categorie_spese {
  id          Int           @id @default(autoincrement())
  nome        String
  Transazione Transazione[]
}
