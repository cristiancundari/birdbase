generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profilo {
  id                 String             @id(map: "Profile_pkey") @db.Uuid
  budget             Float              @default(0)
  ruolo              Role               @default(USER)
  rna                String             @db.VarChar
  googleRefreshToken String?
  covate             Covata[]
  iscrizioni         Iscrizione[]
  ordiniIscrizioni   OrdineIscrizioni[]
  allevatore         Allevatore         @relation(fields: [rna], references: [rna], onDelete: NoAction, onUpdate: NoAction)
  promemoria         Promemoria[]
  soggetti           Soggetto[]
  transazioni        Transazione[]
  inserzioni         Inserzione[]
  ordiniInserzione   OrdineInserzione[]

  @@map("profili")
}

model Soggetto {
  id                 String       @id(map: "Soggetto_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sesso              Boolean?
  dataNascita        DateTime     @map("data_nascita") @db.Date
  gabbia             Int?
  numero             String
  rna                String
  preferito          Boolean      @default(false)
  profiloId          String       @map("profilo_id") @db.Uuid
  avatar             String?
  covataId           Int?         @map("covata_id")
  isMorto            Boolean      @default(false) @map("is_morto")
  anno               String
  note               String       @default("") @db.VarChar
  covateMadre        Covata[]     @relation("covate_id_madreToSoggetto")
  covatePadre        Covata[]     @relation("covate_id_padreToSoggetto")
  iscrizioni         Iscrizione[]
  covata             Covata?      @relation("soggetti_covata_idTocovate", fields: [covataId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  profilo            Profilo      @relation(fields: [profiloId], references: [id])
  inserzioniVendita  Inserzione[] @relation("soggettoVendita")
  inserzioniAcquisto Inserzione[] @relation("soggettoAcquisto")

  @@map("soggetti")
}

model Nazione {
  id    Int    @id(map: "Nazione_pkey") @default(autoincrement())
  nome  String
  sigla String
  gare  Gara[]

  @@map("nazioni")
}

model Gara {
  id               String             @id(map: "Gara_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  titolo           String
  data             DateTime           @db.Date
  tipologia        String
  citta            String
  immagine         String?
  nazioneId        Int                @map("nazione_id")
  createdAt        DateTime           @default(now()) @map("created_at")
  isDeleted        Boolean            @default(false) @map("is_deleted")
  prezzo           Float              @default(0)
  capienza         Int
  stato            GaraStatus         @default(BOZZA)
  nazione          Nazione            @relation(fields: [nazioneId], references: [id])
  iscrizioni       Iscrizione[]
  ordiniIscrizioni OrdineIscrizioni[]

  @@map("gare")
}

model Iscrizione {
  id         String   @id(map: "Iscrizione_Pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  garaId     String   @map("gara_id") @db.Uuid
  soggettoId String   @map("soggetto_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  importo    Float
  posizione  Int?
  voto       Float?
  profiloId  String   @map("profilo_id") @db.Uuid
  gara       Gara     @relation(fields: [garaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  profilo    Profilo  @relation(fields: [profiloId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  soggetto   Soggetto @relation(fields: [soggettoId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("iscrizioni")
}

model Transazione {
  id           Int            @id(map: "Transazione_pkey") @default(autoincrement())
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  categoriaId  Int            @map("categoria_id")
  data         DateTime       @db.Date
  prezzo       Float
  descrizione  String?        @db.VarChar
  modificabile Boolean        @default(true)
  profiloId    String         @map("profilo_id") @db.Uuid
  categoria    CategoriaSpesa @relation(fields: [categoriaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  profilo      Profilo        @relation(fields: [profiloId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("transazioni")
}

model CategoriaSpesa {
  id          Int           @id(map: "categorie_spese_pkey") @default(autoincrement())
  nome        String
  transazioni Transazione[]

  @@map("categorie_spesa")
}

model Covata {
  id          Int        @id @default(autoincrement())
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  data        DateTime   @db.Date
  uovaDeposte Int        @default(0) @map("uova_deposte") @db.SmallInt
  idPadre     String     @map("id_padre") @db.Uuid
  idMadre     String     @map("id_madre") @db.Uuid
  gabbia      Int?       @db.SmallInt
  profiloId   String     @map("profilo_id") @db.Uuid
  completata  Boolean    @default(false)
  madre       Soggetto   @relation("covate_id_madreToSoggetto", fields: [idMadre], references: [id], onDelete: NoAction)
  padre       Soggetto   @relation("covate_id_padreToSoggetto", fields: [idPadre], references: [id], onDelete: NoAction)
  profilo     Profilo    @relation(fields: [profiloId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  figli       Soggetto[] @relation("soggetti_covata_idTocovate")

  @@map("covate")
}

model Allevatore {
  rna     String    @id @db.VarChar
  nome    String    @db.VarChar
  cognome String    @db.VarChar
  profili Profilo[]

  @@map("allevatori")
}

model OrdineIscrizioni {
  id             String   @id @db.VarChar
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  soggetti       Json
  profiloId      String   @map("profilo_id") @db.Uuid
  garaId         String   @map("gara_id") @db.Uuid
  prezzoUnitario Float    @map("prezzo_unitario")
  descrizione    String
  gare           Gara     @relation(fields: [garaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  profilo        Profilo  @relation(fields: [profiloId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("ordini_iscrizioni")
}

model Promemoria {
  titolo             String
  descrizione        String
  priorita           Priorita @default(BASSA)
  completato         Boolean
  data               DateTime @db.Date
  profiloId          String   @map("profilo_id") @db.Uuid
  id                 Int      @id @default(autoincrement())
  ora                DateTime @db.Time(6)
  profilo            Profilo  @relation(fields: [profiloId], references: [id])
  googlePromemoriaId String?  @map("google_promemoria_id")

  @@map("promemoria")
}

model RichiestaRegistrazione {
  id          Int       @id @default(autoincrement())
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  nome        String    @db.VarChar
  cognome     String    @db.VarChar
  email       String    @db.VarChar
  rna         String    @db.VarChar
  docIdentita String    @map("doc_identita") @db.VarChar
  docFoi      String    @map("doc_foi") @db.VarChar
  approvatoIl DateTime? @map("approvato_il") @db.Timestamptz(6)
  rifiutatoIl DateTime? @map("rifiutato_il") @db.Timestamptz(6)
  spiegazione String?

  @@map("richieste_registrazione")
}

model Inserzione {
  id               Int                @id @default(autoincrement())
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  soggettoId       String             @map("soggetto_id") @db.Uuid
  soggettoCopiaId  String?            @map("soggetto_copia_id") @db.Uuid
  profiloId        String             @map("profilo_id") @db.Uuid
  prezzo           Float
  descrizione      String
  soggetto         Soggetto           @relation(name: "soggettoVendita", fields: [soggettoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  soggettoCopia    Soggetto?          @relation(name: "soggettoAcquisto", fields: [soggettoCopiaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  profilo          Profilo            @relation(fields: [profiloId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ordiniInserzioni OrdineInserzione[]

  @@map("inserzioni")
}

model OrdineInserzione {
  id           String     @id
  profiloId    String     @map("profilo_id") @db.Uuid
  inserzioneId Int        @map("inserzione_id")
  profilo      Profilo    @relation(fields: [profiloId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inserzione   Inserzione @relation(fields: [inserzioneId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("ordine_inserzione")
}

enum Role {
  USER
  ADMIN
}

enum GaraStatus {
  BOZZA
  PUBBLICA
  VALUTAZIONE
  COMPLETATA
}

enum Priorita {
  ALTA
  MEDIA
  BASSA
}
